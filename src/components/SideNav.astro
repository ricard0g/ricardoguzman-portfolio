---
interface Props {
	labels: {
		index: string;
		intro: string;
		about: string;
		portfolio: string;
		contact: string;
		language: string;
	};
}

const { labels } = Astro.props;

const currentLang = Astro.url.pathname.startsWith("/en") ? "en" : "es";
---

<!--
	Left-aligned index that fades in once the visitor starts scrolling.
	Starts out `inert` so it can't be tabbed to while hidden.
-->
<nav class="side-nav" aria-label={labels.index} inert>
	<p class="side-nav__title">{labels.index}</p>

	<div class="side-nav__track">
		<span class="side-nav__indicator" aria-hidden="true"></span>
		<ul class="side-nav__list">
			<li>
				<a class="side-nav__item" href="#hero-section" data-section="hero-section">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M18 11V6a2 2 0 0 0-2-2a2 2 0 0 0-2 2"></path>
						<path d="M14 10V4a2 2 0 0 0-2-2a2 2 0 0 0-2 2v2"></path>
						<path d="M10 10.5V6a2 2 0 0 0-2-2a2 2 0 0 0-2 2v8"></path>
						<path
							d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"
						></path>
					</svg>
					{labels.intro}
				</a>
			</li>
			<li>
				<button
					type="button"
					class="side-nav__item"
					data-dialog-open="about-dialog"
					aria-haspopup="dialog"
				>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
						<circle cx="12" cy="7" r="4"></circle>
					</svg>
					{labels.about}
				</button>
			</li>
			<li>
				<a
					class="side-nav__item"
					href="#portfolio-section"
					data-section="portfolio-section"
				>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path
							d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"
						></path>
						<path
							d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"
						></path>
						<path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"></path>
						<path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"></path>
					</svg>
					{labels.portfolio}
				</a>
			</li>
			<li>
				<a
					class="side-nav__item"
					href="#contact-section"
					data-section="contact-section"
				>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<rect width="20" height="16" x="2" y="4" rx="2"></rect>
						<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
					</svg>
					{labels.contact}
				</a>
			</li>
		</ul>
	</div>

	<div class="side-nav__lang" role="group" aria-label={labels.language}>
		<a
			href="/"
			lang="es"
			aria-current={currentLang === "es" ? "page" : undefined}
		>ES</a>
		<span aria-hidden="true">/</span>
		<a
			href="/en"
			lang="en"
			aria-current={currentLang === "en" ? "page" : undefined}
		>EN</a>
	</div>
</nav>

<script>
	import { NAV_SHOW_AFTER, onScrolledPast, watchSections } from "../scripts/scrollState";

	const nav = document.querySelector<HTMLElement>(".side-nav");
	const indicator = nav?.querySelector<HTMLElement>(".side-nav__indicator");
	const items = nav
		? Array.from(nav.querySelectorAll<HTMLAnchorElement>("[data-section]"))
		: [];

	if (nav && indicator) {
		onScrolledPast(NAV_SHOW_AFTER, (visible) => {
			nav.classList.toggle("is-visible", visible);
			nav.inert = !visible;
		});

		const setActive = (id: string) => {
			const active = items.find((item) => item.dataset.section === id);
			if (!active) return;
			items.forEach((item) => {
				if (item === active) item.setAttribute("aria-current", "location");
				else item.removeAttribute("aria-current");
			});
			// Slide the bar next to the active item instead of jumping
			indicator.style.translate = `0 ${active.offsetTop}px`;
			indicator.style.height = `${active.offsetHeight}px`;
			indicator.classList.add("is-ready");
		};

		watchSections(
			items.map((item) => item.dataset.section ?? ""),
			setActive,
		);
		setActive("hero-section");
	}
</script>

<style>
	.side-nav {
		position: fixed;
		top: 80px;
		left: 32px;
		z-index: 10;
		display: none;
		opacity: 0;
		translate: -8px 0;
		transition:
			opacity 200ms ease-out,
			translate 200ms ease-out;
	}

	/* Only where there's room beside the centered content column */
	@media (min-width: 1024px) {
		.side-nav {
			display: block;
		}
	}

	.side-nav.is-visible {
		opacity: 1;
		translate: 0 0;
	}

	.side-nav__title {
		margin-bottom: 20px;
		padding-left: 20px;
		font-size: 11px;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--color-text-main) 60%, transparent);
	}

	.side-nav__track {
		position: relative;
	}

	.side-nav__list {
		display: flex;
		flex-direction: column;
		gap: 4px;
		list-style: none;
	}

	.side-nav__indicator {
		position: absolute;
		top: 0;
		left: 0;
		width: 2px;
		height: 0;
		background-color: var(--color-accent);
		border-radius: 1px;
	}

	/* Only animate after the first placement so it doesn't slide in from the top */
	.side-nav__indicator.is-ready {
		transition:
			translate 200ms ease-out,
			height 200ms ease-out;
	}

	.side-nav__item {
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 6px 0 6px 20px;
		background: none;
		border: none;
		font: inherit;
		font-size: 14px;
		letter-spacing: -0.01em;
		color: color-mix(in srgb, var(--color-text-main) 60%, transparent);
		cursor: pointer;
		transition: color 150ms linear;
	}

	.side-nav__item:hover,
	.side-nav__item[aria-current] {
		color: var(--color-accent);
	}

	.side-nav__item:focus-visible {
		outline: 1px dotted var(--color-accent);
		outline-offset: 2px;
	}

	.side-nav__item svg {
		flex-shrink: 0;
		width: 16px;
		height: 16px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.side-nav__lang {
		display: flex;
		gap: 6px;
		margin-top: 24px;
		padding-left: 20px;
		font-size: 12px;
		letter-spacing: 0.05em;
		color: color-mix(in srgb, var(--color-text-main) 40%, transparent);
	}

	.side-nav__lang a {
		color: color-mix(in srgb, var(--color-text-main) 60%, transparent);
		transition: color 150ms linear;
	}

	.side-nav__lang a:hover,
	.side-nav__lang a[aria-current] {
		color: var(--color-accent);
	}

	@media (prefers-reduced-motion: reduce) {
		.side-nav,
		.side-nav__indicator.is-ready {
			transition: none;
		}
	}
</style>
