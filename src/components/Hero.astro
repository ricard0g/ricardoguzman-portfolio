---
import bgImage from "../assets/pexels-adrien-olichon-1257089-2387793.webp";

interface Props {
	subheading: string;
	description: string;
}

const { subheading, description } = Astro.props;
const heroVideoUrl =
	"https://res.cloudinary.com/dqahemzwr/video/upload/v1776377312/hero_video_saidnk.mp4";
---

<section
	class="hero relative w-full h-screen overflow-hidden bg-cover bg-center"
	style={`background-image: url('${bgImage.src}');`}
>
	<!-- Background video -->
	<video
		class="hero__video absolute inset-0 w-full h-full object-cover"
		src={heroVideoUrl}
		poster={bgImage.src}
		preload="auto"
		autoplay
		loop
		muted
		playsinline
		aria-hidden="true"
	></video>

	<!-- Subtle readability veil over the bright footage -->
	<div class="absolute inset-0 z-1 bg-black/5" aria-hidden="true"></div>

	<!-- Content layer — card anchored center-right -->
	<div
		class="hero__content relative z-2 flex items-center justify-end w-full h-full pt-[8vh] pr-[8vw] pl-[5vw] max-[1000px]:pr-[5vw] max-[768px]:justify-center max-[768px]:px-[4vw]"
	>
		<div
			class="hero__card rotate-3 max-[1000px]:rotate-[1.5deg] max-[640px]:rotate-0 backdrop-blur-lg bg-white/25 border border-white/40 rounded-main p-[clamp(1.5rem,4vh,3rem)] w-[min(520px,85vw)] max-[1400px]:w-[min(460px,80vw)] shadow-[0_8px_32px_rgba(0,0,0,0.12)]"
		>
			<!-- Blinking indicator -->
			<div
				class="hero__blinking-point w-2.5 h-2.5 bg-accent rounded-full opacity-0 mb-[2vh]"
			>
			</div>

			<h1
				class="text-[4.75rem] max-[1400px]:text-[4rem] max-[1000px]:text-[3.5rem] max-[640px]:text-[2.75rem] font-display font-medium uppercase text-accent leading-[0.9]"
			>
				<span class="block">Ricardo</span>
				<span class="block">Guzman</span>
			</h1>

			<h2
				class="mt-[2vh] font-display font-normal text-[2.625rem] max-[1400px]:text-[2rem] max-[1000px]:text-[1.75rem] max-[640px]:text-[1.5rem] tracking-[2px] text-accent/80"
			>
				{subheading}
			</h2>

			<p
				class="mt-[1vh] text-[1.125rem] max-[1400px]:text-[1rem] font-light text-accent/65"
			>
				{description}
			</p>
		</div>
	</div>

	<!-- Bottom fade into the white page background -->
	<div
		class="absolute bottom-0 left-0 right-0 h-[30vh] z-3 pointer-events-none"
		style="background: linear-gradient(to bottom, transparent, var(--color-bg-main));"
		aria-hidden="true"
	></div>
</section>

<style>
	.hero__blinking-point {
		animation: 2s ease-in blinking infinite;
	}

	@keyframes blinking {
		0% {
			opacity: 0;
		}
		50% {
			opacity: 1;
		}
		100% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__video {
			display: none;
		}

		.hero__blinking-point {
			animation: none;
			opacity: 1;
		}
	}
</style>
