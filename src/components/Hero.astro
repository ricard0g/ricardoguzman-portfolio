---
import PaletteIcon from "../assets/icon__palette.svg";
import ChannelIcon from "../assets/icon__channel.svg";
import myPhoto from "../assets/foto-personal-modified.webp";
import jobtrackrImg from "../assets/jobtrackr-hero-page.webp";
import LinkPreview from "./LinkPreview.astro";
import { getCountryInfo } from "../data/funFacts";

interface Props {
	heading: string;
	bio: {
		intro: string;
		name: string;
		middle: string;
		project: string;
		outro: string;
	};
	controls: {
		colors: string;
		colorsLabel: string;
		channel: string;
		channelLabel: string;
	};
	visitor: {
		/** Contains {country} and {flag} placeholders. */
		greeting: string;
		factIntro: string;
		factLink: string;
		factOutro: string;
	};
}

const { heading, bio, controls, visitor } = Astro.props;

// Vercel adds the visitor's country to every request. Locally there's no such
// header, so `?country=MX` can stand in for it during development.
const lang = Astro.currentLocale === "en" ? "en" : "es";
const countryCode =
	Astro.request.headers.get("x-vercel-ip-country") ??
	(import.meta.env.DEV ? Astro.url.searchParams.get("country")?.toUpperCase() : null);
const country = getCountryInfo(countryCode, lang);

// Below lg the greeting is compressed onto the controls' line: the country and
// flag become the fun fact trigger instead of the separate "Fun Fact" sentence.
const [, greetingBefore = "", , greetingAfter = ""] =
	visitor.greeting.match(/^(.*)\{country\}(.*)\{flag\}(.*)$/) ?? [];
---

<section
	id="hero-section"
	class="hero w-full pt-[clamp(6rem,14vh,8.5rem)] max-[768px]:pt-16"
>
	<!--
		The main column follows the same widths as the About section. On large
		screens a three-column grid keeps it centered while the aside controls
		hang off to the right of the screen.
	-->
	<div
		class="hero__layout mx-auto grid grid-cols-1 gap-x-5 [--hero-col:40%] max-[1250px]:[--hero-col:60%] max-[768px]:[--hero-col:80%] max-[425px]:[--hero-col:90%] w-(--hero-col) lg:w-full lg:grid-cols-[1fr_var(--hero-col)_1fr]"
	>
		<div
			class="hero__screen relative aspect-[29/15] max-[640px]:aspect-square w-full overflow-hidden rounded-[10px] lg:col-start-2"
		>
			<canvas
				class="hero__canvas absolute inset-0 h-full w-full"
				role="img"
				aria-label="ASCII art animation: Plasma"></canvas>
		</div>

		<aside
			class="hero__controls mt-3 flex flex-row items-baseline justify-between gap-x-4 lg:col-start-3 lg:row-start-1 lg:mt-6 lg:flex-col lg:items-start lg:justify-start lg:gap-6"
		>
			<div class="ml-auto flex shrink-0 gap-x-5 lg:ml-0 lg:flex-col lg:gap-6">
				<button
					type="button"
					class="hero__control"
					data-control="colors"
					aria-label={controls.colorsLabel}
				>
					<span>{controls.colors}</span>
					<PaletteIcon aria-hidden="true" />
				</button>
				<button
					type="button"
					class="hero__control"
					data-control="channel"
					aria-label={controls.channelLabel}
				>
					<span>{controls.channel}</span>
					<ChannelIcon aria-hidden="true" />
				</button>
			</div>

			{
				country && (
					<p class="hero__visitor-compact order-first min-w-0 text-[14px] leading-[normal] tracking-[-0.01em] text-text-subtle lg:hidden">
						{country.fact ? (
							<>
								{greetingBefore}
								<LinkPreview caption={country.fact} align="start">
									{country.name}
									<span class="hero__flag">{country.flag}</span>
								</LinkPreview>
								{greetingAfter}
							</>
						) : (
							visitor.greeting
								.replace("{country}", country.name)
								.replace("{flag}", country.flag)
						)}
					</p>
				)
			}

			{
				country && (
					<div class="hero__visitor hidden text-[14px] leading-[normal] tracking-[-0.01em] text-text-main lg:mt-6 lg:block lg:max-w-[160px]">
						<p>
							{visitor.greeting
								.replace("{country}", country.name)
								.replace("{flag}", country.flag)}
						</p>
						{country.fact && (
							<p class="mt-[1lh]">
								{visitor.factIntro}
								<LinkPreview caption={country.fact}>{visitor.factLink}</LinkPreview>
								{visitor.factOutro}
							</p>
						)}
					</div>
				)
			}
		</aside>

		<div class="hero__copy mt-6 lg:col-start-2">
			<h1
				class="font-accent text-wrap text-[clamp(1.75rem,5vw,5rem)] lg:text-[clamp(1.75rem,4vw,2.25rem)] leading-[normal] font-normal tracking-[-0.01em] text-accent"
			>
				{heading}
			</h1>
			<p
				class="mt-6 text-sm lg:text-base leading-[1.5] text-text-main"
			>
				{bio.intro}<LinkPreview dialog="about-dialog" image={myPhoto}
					>{bio.name}</LinkPreview
				>{bio.middle}<LinkPreview
					href="https://jobtrakcr.com"
					external
					image={jobtrackrImg}
					imageWidth={220}>{bio.project}</LinkPreview
				>{bio.outro}
			</p>
		</div>
	</div>
</section>

<script>
	import { AsciiScreen, animations, palettes } from "../scripts/ascii";

	const canvas = document.querySelector<HTMLCanvasElement>(".hero__canvas");
	const colorsBtn = document.querySelector('[data-control="colors"]');
	const channelBtn = document.querySelector('[data-control="channel"]');

	if (canvas) {
		let paletteIndex = 0;
		let channelIndex = 0;

		const screen = new AsciiScreen(canvas, animations[channelIndex], {
			fontSize: 12,
			color: palettes[paletteIndex].color,
		});

		colorsBtn?.addEventListener("click", () => {
			paletteIndex = (paletteIndex + 1) % palettes.length;
			screen.setColor(palettes[paletteIndex].color);
		});

		const announce = () => {
			canvas.setAttribute("aria-label", `ASCII art animation: ${animations[channelIndex].name}`);
		};
		announce();

		channelBtn?.addEventListener("click", () => {
			channelIndex = (channelIndex + 1) % animations.length;
			screen.setAnimation(animations[channelIndex]);
			announce();
		});
	}
</script>

<style>
	.hero__control {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		width: fit-content;
		padding: 0;
		background: none;
		border: none;
		cursor: pointer;
		font-size: 14px;
		letter-spacing: -0.01em;
		color: var(--color-accent);
		transition: opacity 100ms linear;
	}

	/* Inline-block keeps the trigger's dotted underline off the flag */
	.hero__flag {
		display: inline-block;
		margin-left: 0.25em;
	}

	/* Below lg the controls sit under the screen; a lighter tone keeps them
	   from competing with the heading and bio */
	@media (width < 64rem) {
		.hero__control {
			color: var(--color-text-subtle);
		}
	}

	.hero__control:hover {
		opacity: 0.65;
	}

	.hero__control:focus-visible {
		outline: 1px dotted var(--color-accent);
		outline-offset: 4px;
	}
</style>
