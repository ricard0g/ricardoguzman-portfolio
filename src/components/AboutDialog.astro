---
import { Image } from "astro:assets";
import myPhoto from "../assets/foto-personal-modified.webp";

interface Props {
	id: string;
	heading: string;
	headingAccent: string;
	closeLabel: string;
	image: {
		alt: string;
		title: string;
	};
	paragraphs: string[];
}

const { id, heading, headingAccent, closeLabel, image, paragraphs } =
	Astro.props;
---

<dialog id={id} class="about-dialog" aria-labelledby={`${id}-title`}>
	<div class="flex items-start justify-between gap-4 mb-4">
		<h2
			id={`${id}-title`}
			class="font-display text-[1.75rem] font-normal leading-tight text-bg-main"
		>
			{heading} <span class="accent-text">{headingAccent}</span>
		</h2>
		<button
			type="button"
			class="about-dialog__close"
			data-dialog-close
			aria-label={closeLabel}
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				width="18"
				height="18"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M18 6 6 18"></path>
				<path d="m6 6 12 12"></path>
			</svg>
		</button>
	</div>

	<Image
		class="float-right w-[35%] max-[425px]:w-[45%] ml-4 mb-2 rounded-[8px]"
		src={myPhoto}
		width={480}
		alt={image.alt}
		title={image.title}
		loading="eager"
	/>
	{
		paragraphs.map((p) => (
			<p class="mb-3 last:mb-0 text-[1rem] font-light">{p}</p>
		))
	}
</dialog>

<script>
	// Any element with data-dialog-open="<id>" opens that dialog
	document.addEventListener("click", (event) => {
		const target = event.target as HTMLElement;

		const opener = target.closest<HTMLElement>("[data-dialog-open]");
		if (opener) {
			const dialog = document.getElementById(opener.dataset.dialogOpen ?? "");
			if (dialog instanceof HTMLDialogElement) dialog.showModal();
			return;
		}

		if (target.closest("[data-dialog-close]")) {
			target.closest("dialog")?.close();
			return;
		}

		// A click landing on the dialog element itself is a click on the backdrop
		if (target instanceof HTMLDialogElement) target.close();
	});
</script>

<style>
	.about-dialog {
		--dialog-radius: 16px;
		--dialog-duration: 150ms;
		width: min(640px, calc(100% - 32px));
		max-height: min(80vh, 720px);
		margin: auto;
		padding: 24px;
		overflow-y: auto;
		background-color: var(--color-accent);
		color: var(--color-text-dark-bg);
		color-scheme: dark;
		scrollbar-color: var(--color-accent-hover) transparent;
		border: none;
		border-radius: var(--dialog-radius);
		/* Same top-down reveal as the link previews */
		clip-path: inset(0 0 100% 0 round var(--dialog-radius));
		transition:
			clip-path var(--dialog-duration) ease-out,
			overlay var(--dialog-duration) allow-discrete,
			display var(--dialog-duration) allow-discrete;
	}

	.about-dialog[open] {
		clip-path: inset(0 round var(--dialog-radius));
	}

	@starting-style {
		.about-dialog[open] {
			clip-path: inset(0 0 100% 0 round var(--dialog-radius));
		}
	}

	.about-dialog::backdrop {
		background-color: rgb(16 20 24 / 0);
		transition:
			background-color var(--dialog-duration) ease-out,
			overlay var(--dialog-duration) allow-discrete,
			display var(--dialog-duration) allow-discrete;
	}

	.about-dialog[open]::backdrop {
		background-color: rgb(16 20 24 / 0.3);
	}

	@starting-style {
		.about-dialog[open]::backdrop {
			background-color: rgb(16 20 24 / 0);
		}
	}

	.about-dialog__close {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 32px;
		height: 32px;
		padding: 0;
		background: none;
		border: none;
		border-radius: 50%;
		color: inherit;
		cursor: pointer;
		transition: background-color 100ms linear;
	}

	.about-dialog__close:hover {
		background-color: var(--color-accent-hover);
	}

	:global(html:has(dialog[open])) {
		overflow: hidden;
	}

	@media (prefers-reduced-motion: reduce) {
		.about-dialog,
		.about-dialog::backdrop {
			transition: none;
		}
	}
</style>
