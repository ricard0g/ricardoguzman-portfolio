---
interface Props {
	aboutLink: {
		text: string;
	};
	portfolioLink: {
		text: string;
	};
	contactLink: {
		text: string;
	};
}

const { aboutLink, portfolioLink, contactLink } = Astro.props;

// Detect current language from URL
const currentPath = Astro.url.pathname;
const currentLang = currentPath.startsWith('/en') ? 'en' : 'es';
---

<header class="flex justify-center w-full">
	<!-- Desktop Navbar -->
	<nav
		class="hidden min-[1151px]:block fixed top-[2.5vh] w-[40%] bg-accent pt-[1.25vh] pb-[1.25vh] px-[1.5vw] rounded-[50px] shadow-m z-10"
	>
		<ul
			class="relative flex flex-row flex-nowrap justify-between items-center list-none p-0"
		>
			<li>
				<a
					href="/"
					class="logo font-display no-underline text-text-dark-bg"
				>
					<span>RICARDO<sup>®</sup></span>
				</a>
			</li>
			<li class="nav__links-container">
				<ul
					class="nav__inner-list absolute top-0 left-1/2 -translate-x-1/2 w-[70%] flex justify-center content-center list-none p-0"
				>
					<li>
						<a class="nav__inner-link" href="#about-section"
							>{aboutLink.text}</a
						>
					</li>
					<li>
						<a class="nav__inner-link" href="#portfolio-section"
							>{portfolioLink.text}</a
						>
					</li>
					<li>
						<a class="nav__inner-link" href="#contact-section"
							>{contactLink.text}</a
						>
					</li>
				</ul>
			</li>
			<li class="flex gap-0.25">
				<a
					href="/"
					class={`lang-btn ${currentLang === 'es' ? 'lang-btn-active' : ''}`}
					aria-label="Español"
				>
					ES
				</a>
				<a
					href="/en"
					class={`lang-btn ${currentLang === 'en' ? 'lang-btn-active' : ''}`}
					aria-label="English"
				>
					EN
				</a>
			</li>
		</ul>
	</nav>

	<!-- Mobile Navbar -->
	<nav
		class="nav-mobile__container block min-[1151px]:hidden fixed top-[2vh] w-[60%] max-[768px]:w-[80%] max-[425px]:w-[95%] bg-accent py-[0.75rem] px-[1.5rem] rounded-[50px] shadow-m z-10"
	>
		<ul
			class="relative flex flex-row flex-nowrap justify-between items-center list-none p-0"
		>
			<li>
				<a
					href="/"
					class="logo font-display no-underline text-text-dark-bg"
				>
					<span>RICARDO<sup>®</sup></span>
				</a>
			</li>
			<li class="flex items-center justify-center">
				<button
					id="burger-btn"
					type="button"
					class="cursor-pointer text-text-dark-bg bg-transparent border-none p-0"
				>
					<svg
						class="svg stroke-bg-main"
						xmlns="http://www.w3.org/2000/svg"
						width="24"
						height="24"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<path d="M4 5h16"></path>
						<path d="M4 12h16"></path>
						<path d="M4 19h16"></path>
					</svg>
				</button>

				<ul
					id="nav-mobile__menu"
					class="nav-mobile__menu hidden absolute top-[2.75rem] right-1/2 translate-x-1/2 w-[70%] bg-accent rounded-main p-[1.5vh] shadow-m list-none z-20"
				>
					<li>
						<a class="nav-mobile__inner-link" href="#about-section"
							>{aboutLink.text}</a
						>
					</li>
					<li>
						<a
							class="nav-mobile__inner-link"
							href="#portfolio-section">{portfolioLink.text}</a
						>
					</li>
					<li>
						<a
							class="nav-mobile__inner-link"
							href="#contact-section">{contactLink.text}</a
						>
					</li>
					<li class="flex gap-2 justify-center">
						<a
							href="/"
							class={`lang-btn ${currentLang === 'es' ? 'lang-btn-active' : ''}`}
							aria-label="Español"
						>
							ES
						</a>
						<a
							href="/en"
							class={`lang-btn ${currentLang === 'en' ? 'lang-btn-active' : ''}`}
							aria-label="English"
						>
							EN
						</a>
					</li>
				</ul>
			</li>
		</ul>
	</nav>
</header>

<script>
	import { initDesktopMenu } from "../scripts/desktopMenu";
	import { initMobileMenu } from "../scripts/mobileMenu";

	if (screen.availWidth < 1151) {
		document.addEventListener("DOMContentLoaded", () => {
			initMobileMenu();
		});
	} else {
		document.addEventListener("DOMContentLoaded", () => initDesktopMenu());
	}
</script>

<style>
	/* Scoped styles for specifics that are hard to utilitize cleanly */
	.nav__inner-list li,
	.nav-mobile__menu li {
		font-size: 0.875rem;
		padding: 0.3rem 0.6rem;
		margin-left: 1rem;
		color: var(--color-text-dark-bg);
		border-radius: var(--radius-main);
		transition: all 100ms linear;
	}

	.nav-mobile__menu li {
		margin-left: 0; /* Reset for mobile */
	}

	.nav__inner-list li:hover,
	.nav-mobile__menu li:hover {
		background-color: var(--color-accent-hover);
	}

	.nav-mobile__menu > li > a {
		display: block;
		width: fit-content;
		margin: 0 auto;
		color: var(--color-text-dark-bg);
		text-align: center;
	}

	.lang-btn {
		padding: 0.375rem 0.75rem;
		color: var(--color-text-dark-bg);
		text-decoration: none;
		font-size: 0.875rem;
		font-weight: 600;
		border-radius: var(--radius-main);
		transition: all 100ms linear;
		opacity: 0.6;
	}

	.lang-btn:hover {
		opacity: 1;
		background-color: var(--color-accent-hover);
	}

	.lang-btn-active {
		opacity: 1;
		background-color: var(--color-accent-hover);
	}
</style>
