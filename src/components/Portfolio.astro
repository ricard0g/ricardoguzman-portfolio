---
import ProjectCard from "./ProjectCard.astro";
import { projectsConfig, type ProjectKey } from "../data/projects";

interface projectProps {
	title: string;
	description: string;
	highlight?: string;
	passwordNote?: string;
	imageAlt: string;
}

interface Props {
	badge: string;
	heading: string;
	headingAccent: string;
	buttons: {
		visit: string;
		github: string;
	};
	projects: Record<ProjectKey, projectProps>;
}

const { badge, heading, headingAccent, buttons, projects } = Astro.props;
---

<section
	id="portfolio-section"
	class="portfolio__container flex justify-center items-center w-full h-auto scroll-mt-10 pt-section px-0"
>
	<div
		class="portfolio__wrapper flex flex-col justify-center items-center gap-y-[1.5vh] w-[55%] max-[768px]:w-[80%] max-[425px]:w-[90%] h-auto text-center"
	>
		<span class="badge">{badge}</span>
		<h2 class="section-heading">
			{heading}
            <span class="accent-text">&#32;{headingAccent}</span>
		</h2>

		<div
			class="portfolio__grid-container max-w-full gap-[1vh] max-[1150px]:gap-[5vh]"
		>
			{
				projectsConfig.map(({ key, ...config }) => (
					<ProjectCard
						projectKey={key}
						buttons={buttons}
						{...config}
						{...projects[key]}
					/>
				))
			}
		</div>
	</div>
</section>

<style>
	.portfolio__grid-container {
		display: grid;
		grid-template: repeat(4, clamp(260px, 22vw, 480px)) / repeat(3, minmax(0, 1fr));
		grid-template-areas:
			"jobtrackr jobtrackr jobtrackr"
			"expensitrack conviertlo conviertlo"
			"abstrakct abstrakct coffetopia"
			"blog sartorial sartorial";
	}

	@media only screen and (max-width: 1150px) {
		.portfolio__grid-container {
			display: grid;
			grid-template: repeat(7, auto) / repeat(1, 100%);
			grid-template-areas:
				"jobtrackr"
				"conviertlo"
				"expensitrack"
				"abstrakct"
				"coffetopia"
				"blog"
				"sartorial";
			height: auto;
		}
	}
</style>
