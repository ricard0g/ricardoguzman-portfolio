---
import abstrakctImg from "../assets/abstrakct_screenshot.webp";
import coffetopiaImg from "../assets/coffetopia_screenshot.webp";
import portfolioImg from "../assets/portfolio-screenshot-modified.webp";
import sartorialImg from "../assets/sartorial_store_screenshot.webp";
import expensitrackImg from "../assets/expensitrack_screenshot.webp";

interface projectProps {
	title: string;
	description: string;
	passwordNote?: string;
	imageAlt: string;
}

interface Props {
	badge: string;
	heading: string;
	headingAccent: string;
	buttons: {
		visit: string;
		github: string;
	};
	projects: {
		expensitrack: projectProps;
		abstrakct: projectProps;
		coffetopia: projectProps;
		blog: projectProps;
		sartorial: projectProps;
	};
}

const { badge, heading, headingAccent, buttons, projects } = Astro.props;

const { expensitrack, abstrakct, coffetopia, blog, sartorial } = projects;
---

<section
	id="portfolio-section"
	class="portfolio__container flex justify-center items-center w-full h-auto mt-[10vh] scroll-mt-10 py-[5vh] px-0"
>
	<div
		class="portfolio__wrapper flex flex-col justify-center items-center gap-y-[1.5vh] w-[60%] max-[1250px]:w-[60%] max-[640px]:w-[95%] h-auto text-center"
	>
		<span class="badge">{badge}</span>
		<h2 class="section-heading">
			{heading}
			<span class="accent-text">{headingAccent}</span>
		</h2>

		<div
			class="portfolio__grid-container max-w-full gap-[1vh] max-[1150px]:gap-[5vh]"
		>
			<!-- Expensitrack -->
			<article
				id="expensitrack-card"
				class="portfolio__proyect-card group w-full h-full bg-white rounded-main shadow-m"
			>
				<figure
					class="relative max-w-full max-h-full rounded-main overflow-hidden"
				>
					<img
						class="portfolio__big-card-img relative left-[5%] top-[2vh] min-w-[600px] max-[1150px]:left-0 max-[1150px]:min-w-[500px] max-[1150px]:max-w-[700px]"
						src={expensitrackImg.src}
						alt={expensitrack.imageAlt}
					/>
					<figcaption
						class="portfolio__card-caption group-hover:visible group-hover:opacity-100 max-[1150px]:visible max-[1150px]:opacity-100"
					>
						<h2
							class="text-[1.5rem] max-[640px]:text-[1.25rem] font-display font-normal"
						>
							{expensitrack.title}
						</h2>
						<p
							class="text-[0.95rem] max-[640px]:text-[0.85rem] font-light"
						>
							{expensitrack.description}
						</p>
						<div
							class="flex justify-center items-center gap-x-[8px] gap-y-[6px] flex-wrap"
						>
							<span
								class="px-3 py-1.5 text-xs font-medium bg-blue-800/80 border border-blue-900 rounded-full text-white transition-all duration-150 hover:bg-blue-900 hover:-translate-y-0.5"
								>TypeScript</span
							>
							<span
								class="px-3 py-1.5 text-xs font-medium bg-red-600/80 border border-red-700 rounded-full text-white transition-all duration-150 hover:bg-red-700 hover:-translate-y-0.5"
								>React Router</span
							>
							<span
								class="px-3 py-1.5 text-xs font-medium bg-cyan-700/80 border border-cyan-800 rounded-full text-white transition-all duration-150 hover:bg-cyan-800 hover:-translate-y-0.5"
								>TailwindCSS</span
							>
							<span
								class="px-3 py-1.5 text-xs font-medium bg-orange-700/80 border border-orange-800 rounded-full text-white transition-all duration-150 hover:bg-orange-800 hover:-translate-y-0.5"
								>Java</span
							>
							<span
								class="px-3 py-1.5 text-xs font-medium bg-green-600/80 border border-green-700 rounded-full text-white transition-all duration-150 hover:bg-green-700 hover:-translate-y-0.5"
								>Spring Boot</span
							>
							<span
								class="px-3 py-1.5 text-xs font-medium bg-amber-600/80 border border-amber-700 rounded-full text-white transition-all duration-150 hover:bg-amber-700 hover:-translate-y-0.5"
								>TanStack Table</span
							>
							<span
								class="px-3 py-1.5 text-xs font-medium bg-zinc-700/80 border border-zinc-800 rounded-full text-white transition-all duration-150 hover:bg-zinc-800 hover:-translate-y-0.5"
								>shadcn/ui</span
							>
							<span
								class="px-3 py-1.5 text-xs font-medium bg-sky-600/80 border border-sky-700 rounded-full text-white transition-all duration-150 hover:bg-sky-700 hover:-translate-y-0.5"
								>Docker</span
							>
							<span
								class="px-3 py-1.5 text-xs font-medium bg-slate-800/80 border border-slate-900 rounded-full text-white transition-all duration-150 hover:bg-slate-900 hover:-translate-y-0.5"
								>Vercel</span
							>
						</div>
						<div
							class="portfolio__links-container flex justify-center items-center gap-x-[10px] gap-y-[5px] flex-wrap"
						>
							<a
								href="https://expensitrack-web.vercel.app/"
								target="_blank"
								class="inline bg-accent py-[0.5rem] max-[640px]:py-[0.75rem] px-[1rem] max-[640px]:px-[1.25rem] rounded-main shadow-m"
								>{buttons.visit}</a
							>
							<a
								href="https://github.com/ricard0g/expensitrack-web"
								target="_blank"
								class="inline bg-accent py-[0.5rem] max-[640px]:py-[0.75rem] px-[1rem] max-[640px]:px-[1.25rem] rounded-main shadow-m"
								>{buttons.github}</a
							>
						</div>
					</figcaption>
				</figure>
			</article>

			<!-- Abstrakct -->
			<article
				id="abstrakct-card"
				class="portfolio__proyect-card group w-full h-full bg-white rounded-main shadow-m"
			>
				<figure
					class="relative max-w-full max-h-full rounded-main overflow-hidden"
				>
					<img
						class="portfolio__big-card-img relative left-[5%] top-[2vh] min-w-[600px] max-[1150px]:left-0 max-[1150px]:min-w-[500px] max-[1150px]:max-w-[700px]"
						src={abstrakctImg.src}
						alt={abstrakct.imageAlt}
					/>
					<figcaption
						class="portfolio__card-caption group-hover:visible group-hover:opacity-100 max-[1150px]:visible max-[1150px]:opacity-100"
					>
						<h2
							class="text-[1.5rem] max-[640px]:text-[1.25rem] font-display font-normal"
						>
							{abstrakct.title}
						</h2>
						<p
							class="text-[0.95rem] max-[640px]:text-[0.85rem] font-light"
						>
							{abstrakct.description}
						</p>
						<div
							class="flex justify-center items-center gap-x-[8px] gap-y-[6px] flex-wrap"
						>
							<span
								class="px-3 py-1.5 text-xs font-medium bg-cyan-400/80 border border-cyan-700 rounded-full text-white transition-all duration-150 hover:bg-cyan-700 hover:-translate-y-0.5"
								>Liquid</span
							>
							<span
								class="px-3 py-1.5 text-xs font-medium bg-blue-800/80 border border-blue-900 rounded-full text-white transition-all duration-150 hover:bg-blue-900 hover:-translate-y-0.5"
								>TypeScript</span
							>
							<span
								class="px-3 py-1.5 text-xs font-medium bg-purple-800/80 border border-purple-900 rounded-full text-white transition-all duration-150 hover:bg-purple-900 hover:-translate-y-0.5"
								>Hydrogen</span
							>
							<span
								class="px-3 py-1.5 text-xs font-medium bg-indigo-800/80 border border-indigo-900 rounded-full text-white transition-all duration-150 hover:bg-indigo-900 hover:-translate-y-0.5"
								>Remix</span
							>
							<span
								class="px-3 py-1.5 text-xs font-medium bg-cyan-700/80 border border-cyan-800 rounded-full text-white transition-all duration-150 hover:bg-cyan-800 hover:-translate-y-0.5"
								>TailwindCSS</span
							>
						</div>
						<div
							class="portfolio__links-container flex justify-center items-center gap-x-[10px] gap-y-[5px] flex-wrap"
						>
							<a
								href="https://abstrakct.netlify.app/"
								target="_blank"
								class="inline bg-accent py-[0.5rem] max-[640px]:py-[0.75rem] px-[1rem] max-[640px]:px-[1.25rem] rounded-main shadow-m"
								>{buttons.visit}</a
							>
							<a
								href="https://github.com/ricard0g/abstrakct"
								target="_blank"
								class="inline bg-accent py-[0.5rem] max-[640px]:py-[0.75rem] px-[1rem] max-[640px]:px-[1.25rem] rounded-main shadow-m"
								>{buttons.github}</a
							>
						</div>
					</figcaption>
				</figure>
			</article>

			<!-- Coffetopia -->
			<article
				id="coffetopia-card"
				class="portfolio__proyect-card group w-full h-full bg-white rounded-main shadow-m"
			>
				<figure
					class="relative max-w-full max-h-full rounded-main overflow-hidden"
				>
					<img
						class="portfolio__small-card-img relative left-[2%] top-[2vh] min-w-[750px] rounded-[5px] max-[1150px]:left-0 max-[1150px]:min-w-[500px] max-[1150px]:max-w-[700px]"
						src={coffetopiaImg.src}
						alt={coffetopia.imageAlt}
					/>
					<figcaption
						class="portfolio__card-caption group-hover:visible group-hover:opacity-100 max-[1150px]:visible max-[1150px]:opacity-100"
					>
						<h2
							class="text-[1.5rem] max-[640px]:text-[1.25rem] font-display font-normal"
						>
							{coffetopia.title}
						</h2>
						<p
							class="text-[0.95rem] max-[640px]:text-[0.85rem] font-light"
						>
							{coffetopia.description} <strong>{coffetopia.passwordNote}</strong>
						</p>
						<div
							class="flex justify-center items-center gap-x-[8px] gap-y-[6px] flex-wrap"
						>
							<span
								class="px-3 py-1.5 text-xs font-medium bg-cyan-400/80 border border-cyan-700 rounded-full text-white transition-all duration-150 hover:bg-cyan-700 hover:-translate-y-0.5"
								>Liquid</span
							>
							<span
								class="px-3 py-1.5 text-xs font-medium bg-blue-800/80 border border-blue-900 rounded-full text-white transition-all duration-150 hover:bg-blue-900 hover:-translate-y-0.5"
								>TypeScript</span
							>
							<span
								class="px-3 py-1.5 text-xs font-medium bg-purple-800/80 border border-purple-900 rounded-full text-white transition-all duration-150 hover:bg-purple-900 hover:-translate-y-0.5"
								>Preact</span
							>
							<span
								class="px-3 py-1.5 text-xs font-medium bg-green-800/80 border border-green-900 rounded-full text-white transition-all duration-150 hover:bg-green-900 hover:-translate-y-0.5"
								>Shopify</span
							>
						</div>
						<div
							class="portfolio__links-container flex justify-center items-center gap-x-[10px] gap-y-[5px] flex-wrap"
						>
							<a
								href="https://coffeee-topia.myshopify.com/password"
								target="_blank"
								class="inline bg-accent py-[0.5rem] max-[640px]:py-[0.75rem] px-[1rem] max-[640px]:px-[1.25rem] rounded-main shadow-m"
								>{buttons.visit}</a
							>
							<a
								href="https://github.com/ricard0g/coffeetopia"
								target="_blank"
								class="inline bg-accent py-[0.5rem] max-[640px]:py-[0.75rem] px-[1rem] max-[640px]:px-[1.25rem] rounded-main shadow-m"
								>{buttons.github}</a
							>
						</div>
					</figcaption>
				</figure>
			</article>

			<!-- Blog -->
			<article
				id="blog-card"
				class="portfolio__proyect-card group w-full h-full bg-white rounded-main shadow-m"
			>
				<figure
					class="relative max-w-full max-h-full rounded-main overflow-hidden"
				>
					<div class="portfolio__blog-img-container">
						<img
							class="portfolio__small-card-img relative left-[2%] top-[2vh] min-w-[550px] rounded-[5px] max-[1150px]:left-0 max-[1150px]:min-w-[500px] max-[1150px]:max-w-[700px]"
							src={portfolioImg.src}
							alt={blog.imageAlt}
							style="top: 3vh; left: 10%;"
						/>
						<!-- Note: inline style for slight adjustment overridden by media query logic partially, keeping inline as source had specific rule #blog-card img -->
					</div>
					<figcaption
						id="blog-caption"
						class="portfolio__card-caption group-hover:visible group-hover:opacity-100 max-[1150px]:visible max-[1150px]:opacity-100"
					>
						<h2
							class="text-[1.5rem] max-[640px]:text-[1.25rem] font-display font-normal"
						>
						{blog.title}
						</h2>
						<p
							class="text-[0.95rem] max-[640px]:text-[0.85rem] font-light"
						>
						{blog.description}
						</p>
						<div
							class="flex justify-center items-center gap-x-[8px] gap-y-[6px] flex-wrap"
						>
							<span
								class="px-3 py-1.5 text-xs font-medium bg-orange-700/80 border border-orange-800 rounded-full text-white transition-all duration-150 hover:bg-orange-800 hover:-translate-y-0.5"
								>Astro</span
							>
						</div>
						<div
							class="portfolio__links-container flex justify-center items-center gap-x-[10px] gap-y-[5px] flex-wrap"
						>
							<a
								href="https://blog.ricardoguzman.dev/"
								target="_blank"
								class="inline bg-accent py-[0.5rem] max-[640px]:py-[0.75rem] px-[1rem] max-[640px]:px-[1.25rem] rounded-main shadow-m"
								>{buttons.visit}</a
							>
							<a
								href="https://github.com/ricard0g/ricardoguzman-blog"
								target="_blank"
								class="inline bg-accent py-[0.5rem] max-[640px]:py-[0.75rem] px-[1rem] max-[640px]:px-[1.25rem] rounded-main shadow-m"
								>{buttons.github}</a
							>
						</div>
					</figcaption>
				</figure>
			</article>

			<!-- Sartorial -->
			<article
				id="sartorial-card"
				class="portfolio__proyect-card group w-full h-full bg-white rounded-main shadow-m"
			>
				<figure
					class="relative max-w-full max-h-full rounded-main overflow-hidden"
				>
					<img
						class="portfolio__big-card-img relative left-[5%] top-[2vh] min-w-[600px] max-[1150px]:left-0 max-[1150px]:min-w-[500px] max-[1150px]:max-w-[700px]"
						src={sartorialImg.src}
						alt={sartorial.imageAlt}
					/>
					<figcaption
						class="portfolio__card-caption group-hover:visible group-hover:opacity-100 max-[1150px]:visible max-[1150px]:opacity-100"
					>
						<h2
							class="text-[1.5rem] max-[640px]:text-[1.25rem] font-display font-normal"
						>
						{sartorial.title}
						</h2>
						<p
							class="text-[0.95rem] max-[640px]:text-[0.85rem] font-light"
						>
							{sartorial.description} <strong
								>{sartorial.passwordNote}</strong
							>
						</p>
						<div
							class="flex justify-center items-center gap-x-[8px] gap-y-[6px] flex-wrap"
						>
							<span
								class="px-3 py-1.5 text-xs font-medium bg-cyan-400/80 border border-cyan-700 rounded-full text-white transition-all duration-150 hover:bg-cyan-700 hover:-translate-y-0.5"
								>Liquid</span
							>
							<span
								class="px-3 py-1.5 text-xs font-medium bg-green-800/80 border border-green-900 rounded-full text-white transition-all duration-150 hover:bg-green-900 hover:-translate-y-0.5"
								>Shopify</span
							>
						</div>
						<div
							class="portfolio__links-container flex justify-center items-center gap-x-[10px] gap-y-[5px] flex-wrap"
						>
							<a
								href="https://sartorial-store.myshopify.com/password"
								target="_blank"
								class="inline bg-accent py-[0.5rem] max-[640px]:py-[0.75rem] px-[1rem] max-[640px]:px-[1.25rem] rounded-main shadow-m"
								>{buttons.visit}</a
							>
							<a
								href="https://github.com/ricard0g/sartorial-store"
								target="_blank"
								class="inline bg-accent py-[0.5rem] max-[640px]:py-[0.75rem] px-[1rem] max-[640px]:px-[1.25rem] rounded-main shadow-m"
								>{buttons.github}</a
							>
						</div>
					</figcaption>
				</figure>
			</article>
		</div>
	</div>
</section>

<style>
	.portfolio__grid-container {
		display: grid;
		grid-template: repeat(3, 42vh) / repeat(3, minmax(33%, 1fr));
		grid-template-areas:
			"expensitrack expensitrack expensitrack"
			"abstrakct abstrakct coffetopia"
			"blog sartorial sartorial";
	}

	#abstrakct-card {
		grid-area: abstrakct;
	}
	#coffetopia-card {
		grid-area: coffetopia;
	}
	#blog-card {
		grid-area: blog;
	}
	#sartorial-card {
		grid-area: sartorial;
	}
	#expensitrack-card {
		grid-area: expensitrack;
	}

	.portfolio__card-caption {
		visibility: hidden;
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		display: flex;
		flex-flow: column nowrap;
		justify-content: center;
		align-items: center;
		row-gap: 2vh;
		width: 100%;
		height: 100%;
		padding: 0 2vw;
		border-radius: var(--radius-main);
		backdrop-filter: blur(8px);
		background-color: #101418b0;
		color: var(--color-text-dark-bg);
		opacity: 0;
		transition: all 200ms linear;
	}

	.portfolio__proyect-card:hover .portfolio__card-caption {
		visibility: visible;
		opacity: 1;
	}

	/* Media query logic for grid and caption is mostly handled by Tailwind classes, 
       but the Grid definition itself needs to change */
	@media only screen and (max-width: 1150px) {
		.portfolio__grid-container {
			display: grid;
			grid-template: repeat(5, 450px) / repeat(1, 100%);
			grid-template-areas:
				"expensitrack"
				"abstrakct"
				"coffetopia"
				"blog"
				"sartorial";
			height: auto;
		}

		#blog-card img {
			padding: 2vh;
			left: 0% !important; /* Override inline style */
			max-width: 400px !important;
			border-radius: var(--radius-main);
		}

		.portfolio__card-caption {
			visibility: visible !important;
			opacity: 1 !important;
			position: static;
			transform: translateY(-100%);
			height: 30%;
			width: 80%;
			max-width: 90%; /* max-w-640px applies this but strictly it's width 90% */
			margin: 0 auto;
			padding: 1vh;
			background-color: #101418d0;
			box-shadow: 0px 2px 4px #101418d0;
		}
	}

	@media only screen and (max-width: 640px) {
		.portfolio__card-caption {
			width: 90%;
		}
	}
</style>
